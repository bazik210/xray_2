#ifndef ANIMATION_LEXEME_INLINE_H_INCLUDED
#define ANIMATION_LEXEME_INLINE_H_INCLUDED

#include <xray/animation/channel_event_callback.h>
#include "mixing_animation_clip.h"

namespace xray {
namespace animation {
namespace mixing {

inline animation_lexeme::animation_lexeme		(
		mutable_buffer& buffer,
		animation_clip* const animation,
		base_interpolator const* const time_scale_interpolator,
		float const animation_interval_length,
		float const first_interval_time_offset,
		float const time_scale,
		int const synchronization_group_id,
		float const	time_offset,
		bool const override_existing_animation,
		u32 const additivity_priority,
		clip_mix_self const mix_self
	) :
	binary_tree_animation_node	(
		buffer,
		animation,
		time_scale,
		time_scale_interpolator,
		first_interval_time_offset,
		time_offset,
		animation_interval_length,
		mix_self,
		synchronization_group_id,
		override_existing_animation,
		additivity_priority
	),
	base_lexeme				( buffer ),
	m_cloned_instance		( 0 )
{
}

inline animation_lexeme::animation_lexeme	(
		mutable_buffer& buffer,
		animation_clip* const animation,
		animation_lexeme& animation_to_synchronize_with,
		bool const override_existing_animation,
		u32 const additivity_priority
	) :
	binary_tree_animation_node	(
		buffer,
		animation,
		animation_to_synchronize_with.cloned_in_buffer(),
		override_existing_animation,
		additivity_priority
	),
	base_lexeme				( buffer ),
	m_cloned_instance		( 0 )
{
	R_ASSERT				( animation_to_synchronize_with.synchronization_group_id() != -1 );
}

inline animation_lexeme::animation_lexeme					( animation_lexeme& other, bool ) :
	binary_tree_animation_node	( other ),
	base_lexeme				( other, true ),
	m_cloned_instance		( 0 )
{
	if ( other.m_cloned_instance != this )
		m_cloned_instance	= other.m_cloned_instance;
}

inline animation_lexeme* animation_lexeme::cloned_in_buffer	( )
{
	if ( is_cloned() )
		return				this;

	if ( !m_cloned_instance )
		m_cloned_instance	= base_lexeme::cloned_in_buffer< animation_lexeme >( );

	return					m_cloned_instance.c_ptr( );
}

} // namespace mixing
} // namespace animation
} // namespace xray

#endif // #ifndef ANIMATION_LEXEME_INLINE_H_INCLUDED