math::aabb bsp_tree_node::get_aabb() const
{
	if ( m_convex_cache.vertices.empty() )
		return math::aabb().identity();
	math::aabb result = math::create_aabb_min_max( m_convex_cache.vertices.front(), m_convex_cache.vertices.back() );
	for ( math::convex::cache::vertices_type::const_iterator it = m_convex_cache.vertices.begin(); it != m_convex_cache.vertices.end(); ++it )
		result.modify( *it );
	return result;
}

void bsp_tree_node::generate_portals( portal_blanks_type const& blanks )
{
	m_blanks_from_parent = blanks;
	if ( !this->is_leaf() )
	{
		math::plane const& divider = m_triangle_mesh.data[ m_divider_id ].plane;
		portal_blanks_type positive_blanks, negative_blanks;
		const portal_blanks_type::const_iterator end_it = blanks.end();
		for ( portal_blanks_type::const_iterator it = blanks.begin(); it != end_it; ++it )
		{
			bsp_portal_blank positive_blank, negative_blank;
			it->split( divider, positive_blank, negative_blank );
			if ( positive_blank.get_vertices().size() >= 3 )
				positive_blanks.push_back( positive_blank );
			if ( negative_blank.get_vertices().size() >= 3 )
				negative_blanks.push_back( negative_blank );
		}
		m_poratal_blank.initialize( m_convex, m_convex_cache, m_triangle_mesh.data[ m_divider_id ].plane );
		positive_blanks.push_back( m_poratal_blank );
		negative_blanks.push_back( m_poratal_blank );
		if ( m_positive )
			m_positive->generate_portals( positive_blanks );
		if ( m_negative )
			m_negative->generate_portals( negative_blanks );
	}
	else
	{
		this->initialize_leaf_mesh( m_leaf_mesh );
		portal_blanks_type::const_iterator const blank_end_it = blanks.end();
		for ( portal_blanks_type::const_iterator it = blanks.begin(); it != blank_end_it; ++it )
		{
			triangle_ids_set_type coincident_triangles; 
			get_triangles_coincident_to_plane( m_leaf_mesh, it->get_plane(), coincident_triangles );
			if ( coincident_triangles.empty() )
				continue;
			edges_type edges;
			get_outer_edges( m_leaf_mesh, coincident_triangles, edges );
			R_ASSERT( !edges.empty() );
			m_outer_edges.insert( m_outer_edges.end(), edges.begin(), edges.end() );
			input_indices_type input_indices;
			get_vertex_indices_of_triangles( m_leaf_mesh, coincident_triangles, input_indices );
			if ( input_indices.size() < 3 )
				continue;
			typedef	xray::ai::navigation::constrained_delaunay_triangulator::indices_type indices_type;
			typedef xray::ai::navigation::delaunay_triangulator delaunay_triangulator;
			u32 const max_triangle_count = delaunay_triangulator::get_maximum_triangle_count_in_triangulation( m_leaf_mesh.vertices.size() );
			indices_type output_indices ( ALLOCA( max_triangle_count * 3 * sizeof( indices_type::value_type ) ), max_triangle_count, 0 );
			xray::ai::navigation::constrained_delaunay_triangulator( m_leaf_mesh.vertices, input_indices, output_indices, it->get_plane().normal, edges, u32( -1 ) );
			u32 const triangle_count = output_indices.size() / 3;
			R_ASSERT( output_indices.size() % 3 == 0 );
			edges_type::const_iterator const edge_end_it = edges.end();
			for ( u32 i = 0; i < triangle_count; ++i )
			{
				u32 const first		= output_indices[ i * 3 ];
				u32 const second	= output_indices[ i * 3 + 1 ];
				u32 const third		= output_indices[ i * 3 + 2 ];
				for ( edges_type::const_iterator edge_it = edges.begin(); edge_it != edge_end_it; ++edge_it )
				{
					if ( ( edge_it->vertex_index0 == second	) && ( edge_it->vertex_index1 == first	) ||
						 ( edge_it->vertex_index0 == third	) && ( edge_it->vertex_index1 == second	) ||
						 ( edge_it->vertex_index0 == first	) && ( edge_it->vertex_index1 == third	) )
					{
						indices_type::const_iterator const first_it = output_indices.begin() + i * 3;
						m_portal_indices.insert( m_portal_indices.end(), first_it, first_it + 3 );
						break;
					}
				}
			}
			//m_portal_indices.insert( m_portal_indices.end(), output_indices.begin(), output_indices.end() );
		}
	}
}

void bsp_tree_node::initialize_leaf_mesh	( triangles_mesh_type& local_mesh ) const
{
	R_ASSERT( this->is_leaf() );
	u32 index_counter = 0;
	triangle_ids_type::const_iterator const id_end_it = m_triangle_ids.end();
	for ( triangle_ids_type::const_iterator it = m_triangle_ids.begin(); it != id_end_it; ++it )
	{
		math::float3 const& first	=	m_triangle_mesh.vertices[ m_triangle_mesh.indices[ (*it) * 3 ] ];
		math::float3 const& second	=	m_triangle_mesh.vertices[ m_triangle_mesh.indices[ (*it) * 3 + 1] ];
		math::float3 const& third	=	m_triangle_mesh.vertices[ m_triangle_mesh.indices[ (*it) * 3 + 2] ];
		local_mesh.vertices.push_back( first );
		local_mesh.vertices.push_back( second );
		local_mesh.vertices.push_back( third );
		local_mesh.indices.push_back( index_counter++ );
		local_mesh.indices.push_back( index_counter++ );
		local_mesh.indices.push_back( index_counter++ );
		local_mesh.data.push_back( bsp_tree_triangle( m_triangle_mesh.data[ *it ].plane ) );
	}
	remove_duplicates( local_mesh );
	ai::navigation::graph_generator_adjacency_builder ( local_mesh.indices, local_mesh.data );
}

void bsp_tree_node::draw_outer_edges( render::scene_ptr const& scene, render::debug::renderer& r ) const
{
	math::color const edeges_color( 255, 255, 0 );
	edges_type::const_iterator const end_it = m_outer_edges.end();
	for ( edges_type::const_iterator it = m_outer_edges.begin(); it != end_it; ++it )
	{
		r.draw_line( scene, m_leaf_mesh.vertices[ it->vertex_index0 ], m_leaf_mesh.vertices[ it->vertex_index1 ], edeges_color );
		//r.draw_arrow(  scene, m_leaf_mesh.vertices[ it->vertex_index0 ], m_leaf_mesh.vertices[ it->vertex_index1 ], edeges_color, edeges_color );
	}
}
