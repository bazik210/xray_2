namespace xray {
namespace model_editor {

struct separation_result
{
	separation_result( u32 polygon_id, float  rel, u32 split, u32 coincident, float square )
		:id( polygon_id ), relation( rel ), split_count( split ), coincident_count(coincident), coincident_square( square ){}
	float get_rating() const
	{
		return coincident_square * relation;
	}
	u32					id;
	float				relation;
	u32					split_count;
	u32					coincident_count;
	float				coincident_square;
};

struct separation_result_better : public std::binary_function<separation_result const&, separation_result const&, bool>
{
	bool operator() ( separation_result const& first, separation_result const& second ) const
	{
		return first.split_count <= second.split_count && first.get_rating() > second.get_rating();
	}
};

typedef set<u32> triangle_ids_set_type;
void get_adjacent_coincident_triangles( u32 triangle_id, triangles_mesh_type const& triangle_mesh, math::convex const& bounding_convex, triangle_ids_set_type& coincident_triangles )
{
	math::float3 const& v0 = triangle_mesh.vertices[ triangle_mesh.indices[ triangle_id * 3 ] ];
	math::float3 const& v1 = triangle_mesh.vertices[ triangle_mesh.indices[ triangle_id * 3 + 1] ];
	math::float3 const& v2 = triangle_mesh.vertices[ triangle_mesh.indices[ triangle_id * 3 + 2] ];
	if ( !bounding_convex.inside( v0 ) && !bounding_convex.inside( v1 ) && !bounding_convex.inside( v2 ) )
		return;
	static u32 const c_neihbours_count = 3;
	coincident_triangles.insert( triangle_id );
	bsp_tree_triangle const& current = triangle_mesh.data[ triangle_id ];
	for ( u32 i = 0; i < c_neihbours_count; ++i )
	{
		u32 const neighbour_id = current.neighbours[ i ];
		if ( neighbour_id == bsp_tree_triangle::msc_empty_triangle_id || coincident_triangles.find( neighbour_id ) != coincident_triangles.end() )
			continue;
		bsp_tree_triangle const& neighbour = triangle_mesh.data[ neighbour_id ];
		if ( neighbour.is_coplanar( current.plane ) )
			get_adjacent_coincident_triangles( neighbour_id, triangle_mesh, bounding_convex, coincident_triangles );
	}
}

void simplified_get_adjacent_coincident_triangles( u32 triangle_id, triangles_mesh_type const& triangle_mesh, triangle_ids_set_type& coincident_triangles )
{
	static u32 const c_neihbours_count = 3;
	coincident_triangles.insert( triangle_id );
	bsp_tree_triangle const& current = triangle_mesh.data[ triangle_id ];
	for ( u32 i = 0; i < c_neihbours_count; ++i )
	{
		u32 const neighbour_id = current.neighbours[ i ];
		if ( neighbour_id == bsp_tree_triangle::msc_empty_triangle_id || coincident_triangles.find( neighbour_id ) != coincident_triangles.end() )
			continue;
		bsp_tree_triangle const& neighbour = triangle_mesh.data[ neighbour_id ];
		if ( neighbour.is_coplanar( current.plane ) )
			simplified_get_adjacent_coincident_triangles( neighbour_id, triangle_mesh, coincident_triangles );
	}
}

void get_triangles_coincident_to_plane( triangles_mesh_type const& triangle_mesh, math::plane const& p, triangle_ids_set_type& coincident_triangles )
{
	u32 const triangle_count = triangle_mesh.data.size();
	for ( u32 i = 0; i < triangle_count; ++i )
	{
		if ( coincident_triangles.find( i ) == coincident_triangles.end() && triangle_mesh.data[ i ].is_coplanar( p ) )
		{
			if ( !coincident_triangles.empty() )
				coincident_triangles.insert( i );
			else
				simplified_get_adjacent_coincident_triangles( i, triangle_mesh, coincident_triangles );
		}
	}
}

void get_outer_edges( triangles_mesh_type const& triangle_mesh, triangle_ids_set_type const& coincident_triangles, edges_type& edges )
{
	triangle_ids_set_type::const_iterator const triangle_end_it = coincident_triangles.end();
	for ( triangle_ids_set_type::const_iterator triangle_it = coincident_triangles.begin(); triangle_it != triangle_end_it; ++triangle_it )
	{
		u32 const current_id				= *triangle_it;
		bsp_tree_triangle const& current	= triangle_mesh.data[ current_id ];
		u32 const first_neighbour_id		= current.neighbours[ 0 ];
		u32 const second_neighbour_id		= current.neighbours[ 1 ];
		u32 const third_neighbour_id		= current.neighbours[ 2 ];
		u32 const first_index				= triangle_mesh.indices[ current_id * 3 ];
		u32 const second_index				= triangle_mesh.indices[ current_id * 3 + 1 ];
		u32 const third_index				= triangle_mesh.indices[ current_id * 3 + 2 ];
		
		if ( first_neighbour_id == bsp_tree_triangle::msc_empty_triangle_id || !triangle_mesh.data[ first_neighbour_id ].is_coplanar( current.plane ) )
			edges.push_back( edge( first_index, second_index ) );

		if ( second_neighbour_id == bsp_tree_triangle::msc_empty_triangle_id || !triangle_mesh.data[ second_neighbour_id ].is_coplanar( current.plane )	)
			edges.push_back( edge( second_index, third_index ) );

		if ( third_neighbour_id == bsp_tree_triangle::msc_empty_triangle_id || !triangle_mesh.data[ third_neighbour_id ].is_coplanar( current.plane )	)
			edges.push_back( edge( third_index, first_index ) );	
	}
}

typedef	xray::ai::navigation::constrained_delaunay_triangulator::input_indices_type input_indices_type;
void get_vertex_indices_of_triangles( triangles_mesh_type const& triangle_mesh, triangle_ids_set_type const& triangles, input_indices_type& indices )
{
	indices.reserve( triangles.size() );
	triangle_ids_set_type::const_iterator const end_it = triangles.end();
	for ( triangle_ids_set_type::const_iterator it = triangles.begin(); it != end_it; ++it )
	{
		u32 const triangle_id = *it;
		indices.push_back( triangle_mesh.indices[ triangle_id * 3 ] );
		indices.push_back( triangle_mesh.indices[ triangle_id * 3 + 1 ] );
		indices.push_back( triangle_mesh.indices[ triangle_id * 3 + 2 ] );
	}
	std::sort( indices.begin(), indices.end() );
	indices.erase( std::unique( indices.begin(), indices.end() ), indices.end() );
}
