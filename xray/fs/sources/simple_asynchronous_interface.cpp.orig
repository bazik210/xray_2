simple_asynchronous_interface::simple_asynchronous_interface	(watcher_enabled_bool watcher_enabled)
	:	hdd_async	(& hdd_device, watcher_enabled),
		dvd_async	(& dvd_device, watcher_enabled),
		hdd_thread	(& hdd_async, "hdd", "hdd"),
