namespace xray {
namespace ai {
namespace sensors {

vision_sensor::vision_sensor		( npc& npc, ai_world& world, brain_unit& brain, configs::binary_config_value const& options )
	:	active_sensor_base			( npc, world, brain ),
		m_fov						( memory::uninitialized_value<float>() ),
		m_max_objects_count			( memory::uninitialized_value<u32>() ),
		m_min_indirect_view_factor	( memory::uninitialized_value<float>() ),
		m_max_indirect_view_factor	( memory::uninitialized_value<float>() ),
		m_far_plane_distance		( memory::uninitialized_value<float>() ),
		m_near_plane_distance		( memory::uninitialized_value<float>() ),
		m_aspect_ratio				( memory::uninitialized_value<float>() ),
		m_time_quant				( memory::uninitialized_value<float>() ),
		m_decrease_factor			( memory::uninitialized_value<float>() ),
		m_velocity_factor			( memory::uninitialized_value<float>() ),
		m_transparency_threshold	( memory::uninitialized_value<float>() ),
		m_luminosity_factor			( memory::uninitialized_value<float>() ),
		m_visibility_inertia		( memory::uninitialized_value<u32>() ),
		m_max_visibility			( memory::uninitialized_value<float>() ),
		m_min_visibility			( memory::uninitialized_value<float>() ),
		m_last_tick					( world.get_current_time() ),
		m_subscription				( boost::bind( &vision_sensor::on_visible_object_destruction, return_this(), _1 ) )
{
	set_parameters							( options );
	m_world.destruction_manager().subscribe	( m_subscription );
}

inline vision_sensor* vision_sensor::return_this( )
{
	return this;
}

vision_sensor::~vision_sensor					( )
{
	m_world.destruction_manager().unsubscribe	( m_subscription );

	while ( sensed_visual_object* visual_object = m_visible_objects.pop_front() )
		DELETE									( visual_object );
}

struct find_visual_object_predicate : private boost::noncopyable
{
	inline find_visual_object_predicate		( game_object const& ai_game_object )
		:	visual_object					( ai_game_object )
	{
	}
	
	inline bool	operator ( )	( sensed_visual_object* const current_object ) const
	{
		return current_object->object == &visual_object;
	}

	game_object const&			visual_object;
};

bool vision_sensor::is_object_visible		(
		game_object const* const ai_game_object,
		visible_objects& objects_list
	)
{
	return find_visual_object_in_list		( ai_game_object, objects_list ) != 0;
}

bool vision_sensor::is_object_in_frustum	(
		sensed_visual_object const* visual_object,
		ai_objects_type const& objects_in_frustum
	)
{
	ai_objects_type::const_iterator iter = std::find	(
												objects_in_frustum.begin(),
												objects_in_frustum.end(),
												&*visual_object->object
											);
	return iter != objects_in_frustum.end();
}

sensed_visual_object* vision_sensor::find_visual_object_in_list	( 
		game_object const* const ai_game_object,
		visible_objects& objects_list
	)
{
	find_visual_object_predicate check_predicate( *ai_game_object );
	return objects_list.find_if					( check_predicate );
}

void vision_sensor::check_frustum	( ai_objects_type& objects_in_frustum )
{
	math::float4x4 projection		= math::create_perspective_projection(
												math::deg2rad( m_fov ),
												m_aspect_ratio,
												m_near_plane_distance,
												m_far_plane_distance
											);
	math::frustum view_frustum		( mul4x4( m_npc.get_eyes_matrix(), projection ) );
	m_world.get_visible_objects		( view_frustum, objects_in_frustum );
}

struct cleansing_visible_objects_predicate : private boost::noncopyable
{
	inline cleansing_visible_objects_predicate	( ai_objects_type const& objects_in_frustum ) :
		currently_in_frustum_objects			( objects_in_frustum )
	{
	}
	
	bool operator()						( sensed_visual_object* visual_object )
	{
		bool const is_in_frustum		= vision_sensor::is_object_in_frustum( visual_object, currently_in_frustum_objects );
		if ( is_in_frustum )
			return						false;

		DELETE							( visual_object );	
		return							true;
	}

	ai_objects_type const&				currently_in_frustum_objects;
};

void vision_sensor::delete_not_in_frustum 					( ai_objects_type const& objects_in_frustum )
{
	cleansing_visible_objects_predicate cleansing_predicate	( objects_in_frustum );
	m_visible_objects.remove_if								( cleansing_predicate );
}

void vision_sensor::add_new_visible_object		( game_object const* const ai_game_object )
{
	sensed_visual_object* visual_object			= NEW( sensed_visual_object );
	visual_object->object						= ai_game_object;
	m_visible_objects.push_back					( visual_object );
}

void vision_sensor::add_objects_from_frustum	( ai_objects_type const& objects_in_frustum )
{
	for ( ai_objects_type::const_iterator iter = objects_in_frustum.begin(); iter != objects_in_frustum.end(); ++iter )
	{
		game_object const* const ai_game_object	= *iter;
		npc const* const testing_npc = ai_game_object->cast_npc();
		if ( ( testing_npc && testing_npc != &m_npc || !testing_npc ) && !is_object_visible( ai_game_object, m_visible_objects ) )
		{
			add_new_visible_object( ai_game_object );
		}
	}
}

struct update_visibility_parameters
{
	npc const*	object_to_ignore;
	float3		npc_position;
	float		time_quant;
	float		velocity_factor;
	float		luminosity_factor;
	float		decrease_factor;
	float		far_plane_distance;
	float		max_visibility_value;
	float		min_visibility_value;
};

struct update_visibility_predicate : private boost::noncopyable
{
	inline update_visibility_predicate			( ai_world& ai_world, update_visibility_parameters& visibility_parameters )
		:	world								( ai_world ),
			parameters							( visibility_parameters )
	{
	}
	
	void operator()								( sensed_visual_object* visual_object )
	{
		float ray_energy						= 1.f;
		if ( visual_object->local_point == float3( memory::uninitialized_value< float >(), memory::uninitialized_value< float >(), memory::uninitialized_value< float >() ) )
			visual_object->local_point			= visual_object->object->get_random_surface_point( world.get_current_time() );

		float3 const& point_in_world_frame		= visual_object->object->local_to_cell( parameters.npc_position ).transform_position( visual_object->local_point );

		bool const ray_query_succeeded			= world.ray_query(
													visual_object->object->get_collision_object(),
													parameters.object_to_ignore->cast_game_object()->get_collision_object(),
													parameters.npc_position,
													normalize( point_in_world_frame - parameters.npc_position ),
													parameters.far_plane_distance,
													ray_energy
												);
//		npc const* other_npc					= visual_object->object->cast_npc();
//		float3 const& pos						= other_npc ? other_npc->get_position( float3( 0, 0, 0 ) ) : float3( -1.f, -1.f, -1.f );
//		LOG_INFO								( "random point: %f %f %f, visible: %s, position: %f %f %f", point_in_world_frame.x, point_in_world_frame.y, point_in_world_frame.z, ( ray_query_succeeded ? "+" : "-" ), pos.x, pos.y, pos.z );
		world.draw_ray							( parameters.npc_position, point_in_world_frame, ray_query_succeeded );
		
		u32 const time_delta					= visual_object->last_time_seen == memory::uninitialized_value<u32>() ?
												0 : ( world.get_current_time() - visual_object->last_time_seen ) / 1000;
		if ( ray_query_succeeded )
		{
			visual_object->own_position			= parameters.npc_position;
			visual_object->distance				= ( point_in_world_frame - parameters.npc_position ).length();
			visual_object->last_time_seen		= world.get_current_time();
		}
		else
		{
			visual_object->local_point			= float3( memory::uninitialized_value< float >(), memory::uninitialized_value< float >(), memory::uninitialized_value< float >() );
		}
		
		float const calculated_luminosity		= exp( visual_object->object->get_luminosity() * parameters.luminosity_factor );
		float const visibility_delta			= time_delta / parameters.time_quant * calculated_luminosity *
												( 1.f + parameters.velocity_factor * visual_object->object->get_velocity() ) *
												parameters.decrease_factor; 
		float visibility_value					= visual_object->visibility_value +
												( visibility_delta * ( ray_query_succeeded ? ( 1 + ray_energy ): -1 ) );

		if ( visibility_value < parameters.min_visibility_value )
			visibility_value					= parameters.min_visibility_value;
		else if ( visibility_value > parameters.max_visibility_value )
			visibility_value					= parameters.max_visibility_value;

		visual_object->updated					= visual_object->visibility_value != visibility_value;
		visual_object->visibility_value			= visibility_value;
	}

	ai_world&									world;
	update_visibility_parameters&				parameters;	
};

void vision_sensor::update_visibility			( )
{
	update_visibility_parameters				visibility_parameters;
	visibility_parameters.object_to_ignore		= &m_npc;
	visibility_parameters.npc_position			= m_npc.get_eyes_position();
	visibility_parameters.time_quant			= m_time_quant;
	visibility_parameters.velocity_factor		= m_velocity_factor;
	visibility_parameters.luminosity_factor		= m_luminosity_factor;
	visibility_parameters.decrease_factor		= m_decrease_factor;
	visibility_parameters.far_plane_distance	= m_far_plane_distance;
	visibility_parameters.max_visibility_value	= m_max_visibility;
	visibility_parameters.min_visibility_value	= m_min_visibility;

	update_visibility_predicate					visibility_predicate( m_world, visibility_parameters );
	m_visible_objects.for_each					( visibility_predicate );
}

void vision_sensor::update_visible_objects	( )
{
	ai_objects_type	objects					( g_allocator );
	check_frustum							( objects );
	delete_not_in_frustum					( objects );
	add_objects_from_frustum				( objects );
	update_visibility						( );
}

void vision_sensor::tick			( )
{
	if ( !m_enabled )
		return;

	u32 const current_time			= m_world.get_current_time();
	
	if ( current_time - m_last_tick < 1000 )
		return;

	update_visible_objects			( );
	update_perceptors				( );

#ifdef DEBUG
	m_world.draw_frustum			(
		math::deg2rad( m_fov ),
		m_far_plane_distance,
		m_aspect_ratio,
		m_npc.get_eyes_position(),
		m_npc.get_eyes_direction(),
		m_npc.get_color()
	);
#endif // #ifdef DEBUG
}

struct update_perceptors_predicate : private boost::noncopyable
{
	inline update_perceptors_predicate	( vision_sensor const& sensor ) :
		vision							( sensor )
	{
	}
	
	void operator()						( sensed_visual_object* sensed_object ) const
	{
		if ( sensed_object->updated )
		{
			vision.add_fact				( sensed_object ); 
		}
	}

	vision_sensor const&				vision;
};

void vision_sensor::update_perceptors					( ) const
{		
	update_perceptors_predicate perceptors_predicate	( *this );
	m_visible_objects.for_each							( perceptors_predicate ); 
}

void vision_sensor::add_fact			( sensed_visual_object* visual_object ) const
{
	sensed_object visible_object		(
		visual_object->own_position,
		visual_object->local_point,
		c_ptr( visual_object->object ),
		m_world.get_current_time(),
		sensed_object_type_visual,
		1.f // TODO: confidence value must be based on sensed_object->visibility_value
	);
	m_brain_unit.on_seen_object			( visible_object );
}

void vision_sensor::set_parameters		( configs::binary_config_value const& options )
{
	if ( !options.value_exists( "vision_sensor_parameters" ) )
		return;

	configs::binary_config_value const& vision_parameters	= options["vision_sensor_parameters"];
	
	m_enabled					= vision_parameters["enabled"];
	m_fov						= vision_parameters["fov"];
	m_max_objects_count			= vision_parameters["max_objects_count"];
	m_min_indirect_view_factor	= vision_parameters["min_indirect_view_factor"];
	m_max_indirect_view_factor	= vision_parameters["max_indirect_view_factor"];
	m_far_plane_distance		= vision_parameters["far_plane_distance"];

	static int i				= 0;
	m_far_plane_distance		+= i++ * 10.f;

	m_near_plane_distance		= vision_parameters["near_plane_distance"];
	float aspect_ratio_major	= vision_parameters["aspect_ratio_longer_dimension"];
	float aspect_ratio_minor	= vision_parameters["aspect_ratio_shorter_dimension"];
	m_aspect_ratio				= (float)aspect_ratio_major / aspect_ratio_minor;
	m_time_quant				= vision_parameters["time_quant"];
	m_decrease_factor			= vision_parameters["decrease_factor"];
	m_velocity_factor			= vision_parameters["velocity_factor"];
	m_transparency_threshold	= vision_parameters["transparency_threshold"];
	m_luminosity_factor			= vision_parameters["luminosity_factor"];
	m_visibility_inertia		= vision_parameters["visibility_inertia"];
	m_max_visibility			= vision_parameters["max_visibility"];
	m_min_visibility			= vision_parameters["min_visibility"];
}

void vision_sensor::on_visible_object_destruction	( game_object const& destroyed_object )
{
	sensed_visual_object* object_to_be_deleted = find_visual_object_in_list( &destroyed_object, m_visible_objects );
	if ( object_to_be_deleted && m_visible_objects.erase( object_to_be_deleted ) )
	{
		DELETE	( object_to_be_deleted );
	}
}

void vision_sensor::dump_state			( npc_statistics& stats ) const
{
	npc_statistics::sensor_info_type	new_stats_item;
	new_stats_item.caption				= "visible objects:";
	for ( sensed_visual_object* iter = m_visible_objects.front(); iter; iter = m_visible_objects.get_next_of_object( iter ) )
		new_stats_item.content.push_back( iter->object->get_name() );

	if ( m_visible_objects.empty() )
		new_stats_item.content.push_back( "none" );
	
	stats.sensors_state.push_back		( new_stats_item );
}

} // namespace sensors
} // namespace ai
} // namespace xray