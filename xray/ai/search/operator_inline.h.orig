#ifndef XRAY_AI_SEARCH_OPERATOR_INLINE_H_INCLUDED
#define XRAY_AI_SEARCH_OPERATOR_INLINE_H_INCLUDED

namespace xray {
namespace ai {
namespace planning {

#define WORLD_OPERATOR	planning::operator_impl

inline WORLD_OPERATOR::operator_impl	( pcstr id ) :
	m_id								( id )
{
	m_object							= 0;
	m_first_execute						= false;
}

inline pcstr WORLD_OPERATOR::id			( ) const
{
	return m_id.c_str					( );
}

#undef WORLD_OPERATOR

} // namespace planning
} // namespace ai
} // namespace xray

#endif // #ifndef XRAY_AI_SEARCH_OPERATOR_INLINE_H_INCLUDED