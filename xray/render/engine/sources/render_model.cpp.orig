#include <xray/render/core/res_geometry.h>

namespace xray {
namespace render {

render_model::render_model( )
{
	m_aabbox.identity();
}

void render_model::load( memory::chunk_reader& chunk )
{
	if (!chunk.chunk_exists(model_chunk_header))
		return;

	//ASSERT( chunk.chunk_exists( model_chunk_header));
	memory::reader reader = chunk.open_reader( model_chunk_header);
	
	model_header	hdr;
	reader.r		( &hdr, sizeof( hdr), sizeof( hdr));
	m_aabbox		= hdr.bb;
}

void render_model::load_properties( configs::binary_config_value const& properties )
{
	m_aabbox.max			= xray::math::float3(properties["bounding_box"]["max"]);
	m_aabbox.min			= xray::math::float3(properties["bounding_box"]["min"]);
}

void render_surface::load( memory::chunk_reader& chunk )
{
	if (!chunk.chunk_exists(model_chunk_header))
		return;
	
	memory::reader reader = chunk.open_reader( model_chunk_header);
	model_header	hdr;
	reader.r	( &hdr, sizeof( hdr), sizeof( hdr));
	m_aabbox			= hdr.bb;
	
	R_ASSERT( hdr.platform_id==platform_windows_dx11 );
}

void render_surface::set_default_material( )
{
	m_material_effects = material::nomaterial_material( get_vertex_input_type() );
}

void render_surface::set_material( material_ptr mtl_ptr)
{
	material_manager::ref().initialize_material_effects(m_material_effects, mtl_ptr, get_vertex_input_type(), false);
}

void render_surface::set_material_effects( material_effects_instance_ptr mtl_instance_ptr )
{
	if (mtl_instance_ptr)
	{
		m_materail_effects_instance	= mtl_instance_ptr;
		m_material_effects			= mtl_instance_ptr->get_material_effects();
//.		material_manager::ref().add_material_effects(m_material_effects, m_material_effects.m_material);
	}
}

void render_surface::load( configs::binary_config_value const& properties, memory::chunk_reader& chunk )
{
	(void)&chunk;
	
	m_aabbox.max			= xray::math::float3(properties["bounding_box"]["max"]);
	m_aabbox.min			= xray::math::float3(properties["bounding_box"]["min"]);
}

void render_surface_instance::set_constants( )
{
	m_parent->set_constants	( );
}

