#ifndef ANIMATION_LEXEME_H_INCLUDED
#define ANIMATION_LEXEME_H_INCLUDED

#include <xray/animation/mixing_binary_tree_animation_node.h>
#include <xray/animation/mixing_base_lexeme.h>

namespace xray {
namespace animation {
namespace mixing {

class animation_lexeme;

typedef intrusive_ptr<
			animation_lexeme,
			binary_tree_base_node,
			threading::single_threading_policy
> animation_lexeme_ptr;

} // namespace mixing
} // namespace animation

#pragma warning( push )
#pragma warning( disable : 4231 )
template class XRAY_ANIMATION_API
	intrusive_ptr<
		animation::mixing::animation_lexeme,
		animation::mixing::binary_tree_base_node,
		threading::single_threading_policy
	>;
#pragma warning( pop )

namespace animation {
namespace mixing {

class XRAY_ANIMATION_API animation_lexeme :
	public binary_tree_animation_node,
	public base_lexeme
{
public:
	inline					animation_lexeme	(
								mutable_buffer& buffer,
								animation_clip* const animation,
								base_interpolator const* const time_scale_interpolator,
								float const animation_interval_length,
								float const first_interval_time_offset = 0.f,
								float const time_scale = 1.f,
								int const synchronization_group_id = -1,
								float const	time_offset = 0.f,
								bool const override_existing_animation = false,
								u32 const additivity_priority = u32(-1),
								clip_mix_self const mix_self = clip_mix_continue_self
							);
	inline					animation_lexeme	(
								mutable_buffer& buffer,
								animation_clip* const animation,
								animation_lexeme& animation_to_synchronize_with,
								bool const override_existing_animation = false,
								u32 const additivity_priority = u32(-1)
							);
	inline					animation_lexeme	( animation_lexeme& other, bool );
	inline	animation_lexeme* cloned_in_buffer	( );

private:
	animation_lexeme_ptr	m_cloned_instance;
}; // class animation_lexeme

} // namespace mixing
} // namespace animation
} // namespace xray

#include <xray/animation/mixing_animation_lexeme_inline.h>

#endif // #ifndef ANIMATION_LEXEME_H_INCLUDED