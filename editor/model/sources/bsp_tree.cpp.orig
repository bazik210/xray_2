struct parallel_and_near_plane : public std::binary_function< indexed_polygon const*, indexed_polygon const*, bool >
{
	parallel_and_near_plane( float max_distance, float precision ):
		m_max_distance( max_distance ), m_precision( precision ){}

	bool operator()( indexed_polygon const* first, indexed_polygon const* second ) const
	{
		if ( math::is_similar( first->get_plane().normal, second->get_plane().normal, m_precision ) )
		{
			float const dist = math::abs( first->get_plane().d - second->get_plane().d );
			return dist <= m_max_distance;
		}
		else if ( math::is_similar( math::float3( first->get_plane().normal ), -second->get_plane().normal , m_precision ) )
		{		
			float const dist = math::abs( first->get_plane().d + second->get_plane().d );
			return dist <= m_max_distance;
		}
		return false;
	};
private:
	float m_max_distance;
	float m_precision;
};

struct indexed_polygon_square_less : public std::binary_function< indexed_polygon const*, indexed_polygon const*, bool >
{
	bool operator()( indexed_polygon const* first, indexed_polygon const* second ) const
	{
		return first->get_square() < second->get_square();
	}
};

struct indexed_polygon_projection_inside : public std::binary_function< indexed_polygon const*, indexed_polygon const*, bool >
{
	bool operator()( indexed_polygon const* larger_polygon, indexed_polygon const* polygon_to_check ) const
	{
		for ( u32 i = 0; i < polygon_to_check->get_vertices_count(); ++i )
		{
			if ( !is_point_inside_polygon( *larger_polygon, larger_polygon->get_plane().project( polygon_to_check->vertex( i ) ) ) )
				return false;
		}
		return true;
	}
};

