void bsp_tree::reset()
{
	m_selected_node = NULL;
	m_aabb.zero();
	m_vertices.clear();
	m_indices.clear();
	m_edge_mode = false;
	m_created = false;
	m_portals_generated = false;
	DELETE( m_root );
	m_root = NULL;
}

math::aabb bsp_tree::get_aabb () const
{
	if ( m_selected_node )
		return m_selected_node->get_aabb();
	return math::aabb().identity();
}

void bsp_tree::generate_portals( )
{
	if ( m_root )
		m_root->generate_portals( bsp_tree_node::portal_blanks_type() );
	m_portals_generated = true;
}


