#ifndef SMELL_SENSOR_H_INCLUDED
#define SMELL_SENSOR_H_INCLUDED

#include "passive_sensor_base.h"

namespace xray {
namespace ai {
namespace sensors {

class smell_sensor : public passive_sensor_base
{
public:
						smell_sensor	(
							npc& npc,
							ai_world& world,
							brain_unit& brain,
							configs::binary_config_value const& options
						);

	virtual void		set_parameters	( configs::binary_config_value const& options );
	virtual void		dump_state		( npc_statistics& stats ) const;

private:
	u32					m_max_smells_count;
	float				m_max_smelling_distance;
	float				m_min_intensity;
	float				m_max_intensity;
	float				m_always_recognized_distance;
	float				m_decreasing_time_quant;
	float				m_decrease_factor;
	float				m_last_smell_time;
}; // class smell_sensor

} // namespace sensors
} // namespace ai
} // namespace xray

#endif // #ifndef SMELL_SENSOR_H_INCLUDED