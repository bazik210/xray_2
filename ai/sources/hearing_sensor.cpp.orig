#include "pch.h"

#include "hearing_sensor.h"
#include "ai_world.h"
#include "sensed_object_types.h"
#include "sensed_object.h"
#include <xray/ai/npc.h>
#include <xray/ai/sensed_sound_object.h>

namespace xray {
namespace ai {
namespace sensors {

hearing_sensor::hearing_sensor			( npc& npc, ai_world& world, brain_unit& brain, configs::binary_config_value const& options )
	:	passive_sensor_base				( npc, world, brain ),
		m_max_sounds_count				( memory::uninitialized_value<u32>() ),
		m_max_sound_distance			( memory::uninitialized_value<float>() ),
		m_min_sound_threshold			( memory::uninitialized_value<float>() ),
		m_always_recognized_distance	( memory::uninitialized_value<float>() ),		
		m_decreasing_time_quant			( memory::uninitialized_value<float>() ),
		m_decrease_factor				( memory::uninitialized_value<float>() ),
		m_last_sound_time				( memory::uninitialized_value<float>() ),
		m_subscription					( boost::bind( &hearing_sensor::on_perceive_sound, return_this(), _1 ) )
{
	set_parameters						( options );
	m_world.sounds_manager().subscribe	( m_npc, m_subscription );
}

hearing_sensor::~hearing_sensor	( )
{
	m_world.sounds_manager().unsubscribe( m_npc, m_subscription );
}

inline hearing_sensor* hearing_sensor::return_this	( )
{
	return	this;
}

void hearing_sensor::on_perceive_sound	( sensed_sound_object const& perceived_sound ) const
{
	sensed_object sound_object			(
		m_npc.get_position( float3( 0, 0, 0 ) ),
		perceived_sound.position,
		c_ptr( perceived_sound.object ),
		m_world.get_current_time(),
		sensed_object_type_sound,
		perceived_sound.power / 100.f
	);
	m_brain_unit.on_sensed_sound		( sound_object );
}

void hearing_sensor::set_parameters		( configs::binary_config_value const& options )
{
	if ( options.value_exists( "hearing_sensor_parameters" ) )
	{
		configs::binary_config_value const& hearing_parameters	= options["hearing_sensor_parameters"];
		
		m_enabled						= hearing_parameters["enabled"];
		m_max_sounds_count				= hearing_parameters["max_sounds_count"];
		m_max_sound_distance			= hearing_parameters["max_sound_distance"];
		m_min_sound_threshold			= hearing_parameters["min_sound_threshold"];
		m_always_recognized_distance	= hearing_parameters["always_recognized_distance"];
		m_decreasing_time_quant			= hearing_parameters["decreasing_time_quant"];
		m_decrease_factor				= hearing_parameters["decrease_factor"];
		m_last_sound_time				= hearing_parameters["last_sound_time"];
	}
}

void hearing_sensor::dump_state			( npc_statistics& stats ) const
{
	XRAY_UNREFERENCED_PARAMETER			( stats );
}

} // namespace sensors
} // namespace ai
} // namespace xray
